{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "mpd",
        "pulseaudio",
        "backlight",
        "idle_inhibitor",
        "cpu",
        "memory",
        "battery",
        "tray"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{id}"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%H:%M  %d/%m}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "network": {
        "format-wifi": "󰤨  {signalStrength}%",
        "format-ethernet": "󰈀  LAN",
        "format-disconnected": "󰤭  Bağlı değil",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "kitty --class soluk-network -e nmtui"
    },
    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-stopped": "󰝛  Çalmıyor",
        "format-disconnected": "󰝛  Kapalı",
        "state-icons": {
            "playing": "󰐊",
            "paused": "󰏤"
        },
        "interval": 5,
        "max-length": 40,
        "on-click": "kitty --class soluk-music --hold -e rmpc -t ~/.config/soluk/current-theme/rmpc-theme.ron",
        "tooltip-format": "{artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S})"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        "format": "󰕾  {volume}%",
        "format-muted": "󰝟  Sessiz",
        "on-click": "pavucontrol"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        }
    },
    "cpu": {
        "format": "󰍛  {usage}%",
        "interval": 5,
        "on-click": "kitty --class soluk-monitor -e btop"
    },
    "memory": {
        "format": "󰘚  {percentage}%",
        "interval": 5,
        "on-click": "kitty --class soluk-monitor -e btop"
    },
    "battery": {
        "format": "󰁹  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "on-click": "kitty --class soluk-monitor -e btop"
    },
    "tray": {
        "spacing": 10
    }
}
