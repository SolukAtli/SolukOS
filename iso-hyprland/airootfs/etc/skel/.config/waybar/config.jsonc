{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "tray"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "○"
        }
    },
    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "network": {
        "format-wifi": "WiFi {signalStrength}%",
        "format-ethernet": "LAN Bagli",
        "format-disconnected": "Bagli degil",
        "tooltip-format": "{ifname}: {ipaddr}"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "Sessiz",
        "on-click": "pavucontrol"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "RAM {percentage}%",
        "interval": 5
    },
    "battery": {
        "format": "BAT {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "tray": {
        "spacing": 10
    }
}