{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "tray"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "urgent": ""
        }
    },
    "clock": {
        "format": "{:%H:%M  %d/%m}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "network": {
        "format-wifi": "󰤨  {signalStrength}%",
        "format-ethernet": "󰈀  LAN",
        "format-disconnected": "󰤭  Bağlı değil",
        "tooltip-format": "{ifname}: {ipaddr}"
    },
    "pulseaudio": {
        "format": "󰕾  {volume}%",
        "format-muted": "󰝟  Sessiz",
        "on-click": "pavucontrol"
    },
    "cpu": {
        "format": "󰍛  {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "󰘚  {percentage}%",
        "interval": 5
    },
    "battery": {
        "format": "󰁹  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "tray": {
        "spacing": 10
    }
}
